<odoo>
    <record id="view_reading_progress_wizard_form" model="ir.ui.view">
        <field name="name">my_library.reading.progress.wizard.form</field>
        <field name="model">my_library.reading.progress.wizard</field>
        <field name="arch" type="xml">
            <form string="Enregistrer ma progression">
                <group>
                    <field name="book_id" />
                    <field name="page_number" />
                </group>

                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Valider"
                        class="btn-primary" />

                    <button
                        string="Annuler"
                        special="cancel"
                        class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
