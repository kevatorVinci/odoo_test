<odoo>
    <!-- Vue Liste-->
    <record id="view_livre_form" model="ir.ui.view">
        <field name="name">livre.form</field>
        <field name="model">my_library.livre</field>
        <field name="arch" type="xml">
            <form string="Livre">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="publication_date"/>
                        <field name="isbn"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue formulaire -->

    <record id="view_livre_form" model="ir.ui.view">
        <field name="name">livre.tree</field>
        <field name="model">my_library.livre</field>
        <field name="arch" type="xml">
           <form string="Livre">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="publication_date"/>
                        <field name="isbn"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <!-- Action :-->
         <record id="action_livre" model="ir.actions.act_window">
            <field name="name">Livres</field>
            <field name="res_model">my_library.livre</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu principal -->
    <menuitem id="menu_library_root" name="Ma Librairie"/>

    <!-- Menu qui ouvre les livres -->
    <menuitem
        id="menu_library_livres"
        name="Livres"
        parent="menu_library_root"
        action="action_livre"/>
</odoo>
