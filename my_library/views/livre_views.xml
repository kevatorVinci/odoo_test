<odoo>
    <!-- Vue Liste-->
    <record id="view_livre_list" model="ir.ui.view">
    <field name="name">livre.list</field>
    <field name="model">my_library.livre</field>
    <field name="arch" type="xml">
        <list string="Livres">
            <field name="name"/>
            <field name="author"/>
            <field name="category_id"/>
            <field name="price"/>
            <field name="stock_quantity"/>
            <field name="active"/>
        </list>
    </field>
</record>

    <!-- Vue formulaire -->

   <record id="view_livre_form" model="ir.ui.view">
    <field name="name">livre.form</field>
    <field name="model">my_library.livre</field>
    <field name="arch" type="xml">
        <form string="Livre">
            <header>
               <button
    name="action_put_on_sale"
    type="object"
    string="Mettre en vente"
    class="btn-success"
    invisible="active"/>

<button
    name="action_remove_from_sale"
    type="object"
    string="Retirer de la vente"
    class="btn-danger"
    invisible="not active"/>
            </header>

            <sheet>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="category_id"/>
                        <field name="publication_date"/>
                        <field name="isbn"/>
                        <field name="language"/>
                    </group>

                    <group>
                        <field name="price"/>
                        <field name="stock_quantity"/>
                        <field name="active"/>
                    </group>
                </group>

                <group>
                    <field name="description"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<!-- Vue Recherche -->
<record id="view_livre_search" model="ir.ui.view">
    <field name="name">livre.search</field>
    <field name="model">my_library.livre</field>
    <field name="arch" type="xml">
        <search string="Rechercher un livre">
            <!-- Recherche textuelle -->
            <field name="name" string="Titre"/>
            <field name="author" string="Auteur"/>
            <field name="category_id" string="Catégorie"/>

            <!-- Filtres rapides -->
            <filter string="En vente" name="active_books" domain="[('active', '=', True)]"/>

            <!-- Regroupements -->
            <group expand="0" string="Regrouper par">
                <filter string="Catégorie" name="group_category" context="{'group_by': 'category_id'}"/>
                <filter string="Auteur" name="group_author" context="{'group_by': 'author'}"/>
            </group>
        </search>
    </field>
</record>

     <!-- Action :-->
         <record id="action_livre" model="ir.actions.act_window">
            <field name="name">Livres</field>
            <field name="res_model">my_library.livre</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu principal -->
    <menuitem id="menu_library_root" name="Ma Librairie"/>

    <!-- Menu qui ouvre les livres -->
    <menuitem
        id="menu_library_livres"
        name="Livres"
        parent="menu_library_root"
        action="action_livre"/>
</odoo>
